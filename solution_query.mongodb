/*---Exercise 1: Data Setup---*/

db = db.getSiblingDB("companyDB");

db.employees.insertMany([
  {
    name: "Aryan",
    department: "IT",
    salary: 600000,
    age: 24
  },
  {
    name: "Denis",
    department: "UX",
    salary: 16000,
    age: 20
  },
  {
    name: "Rahul",
    department: "Sales",
    salary: 22000,
    age: 50
  },
  {
    name: "kapil",
    department: "Marketing",
    salary: 15000,
    age: 36
  },
  {
    name: "Rajesh",
    department: "Marketing",
    salary: 5000,
    age: 23
  }
]);


/*---Exercise 2: Simple Find Queries---*/

db.employees.find({ department: "IT" });

db.employees.find({ name: "Rahul" });


/*---Exercise 3: Formatting & Distinct---*/

db.employees.find().pretty();

db.employees.distinct("department");


/*---Exercise 4: Salary Analysis ($gt, $lt)---*/

db.employees.find({
  salary: { $gt: 50000 }
});

db.employees.find({
  salary: { $lt: 30000 }
});


/*---Exercise 5: Age Filtering ($gte, $lte)---*/

db.employees.find({
  age: { $gte: 30 }
});

db.employees.find({
  age: { $lte: 25 }
});


/*---Exercise 6: Range Queries---*/

db.employees.find({
  salary: { $gte: 40000, $lte: 80000 }
});
